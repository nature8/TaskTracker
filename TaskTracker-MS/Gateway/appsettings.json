
{

  "ReverseProxy": {

    "Routes": {

      "users-route": {

        "ClusterId": "users-cluster",
        "Match": {

          "Path": "/gateway/users/{**catch-all}"

        },

        "Transforms": [

          {

            "PathRemovePrefix": "/gateway/users"

          },

          {

            "PathPrefix": "/api/users"

          }

        ]

      },

      "tasks-route": {

        "ClusterId": "tasks-cluster",

        "Match": {

          "Path": "/gateway/tasks/{**catch-all}"

        },

        "Transforms": [

          {

            "PathRemovePrefix": "/gateway/tasks"

          },

          {

            "PathPrefix": "/api/tasks"

          }

        ]

      }

    },
    "Clusters": {

      "users-cluster": {

        "Destinations": {

          "destination1": {

            "Address": "http://userservice:8080/"

          }

        }

      },

      "tasks-cluster": {

        "Destinations": {

          "destination1": {

            "Address": "http://taskservice:8080/"

          }

        }

      }

    }

  },

  "Jwt": {

    "Key": "ThisIsASecretKeyForDay3DemoMinimum32Chars!",

    "Issuer": "MicroservicesDemo",

    "Audience": "MicroservicesDemoClients",

    "ExpiryMinutes": "60"

  },

  "AllowedHosts": "*"

}

